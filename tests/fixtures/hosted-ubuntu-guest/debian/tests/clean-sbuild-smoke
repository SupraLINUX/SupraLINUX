#!/usr/bin/env bash
# Clean generic package build inside hosted Ubuntu KVM, NOT a KDE Attempt.
set -Eeuo pipefail
umask 077
source /etc/os-release
[[ "$ID" == ubuntu && "$VERSION_ID" == 26.04 && "$VERSION_CODENAME" == resolute ]]
[[ "$(dpkg --print-architecture)" == amd64 ]]
for exe in sbuild mmdebstrap dpkg-source dpkg-deb dpkg-parsechangelog sha256sum; do
  command -v "$exe" >/dev/null
done
WORK="$(mktemp -d /var/tmp/supralinux-sbuild-smoke.XXXXXXXX)"
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/source/debian/source" "$WORK/out"
cat > "$WORK/source/debian/changelog" <<'EOF'
supralinux-hosted-sbuild-smoke (0.1) resolute; urgency=low

  * Prove a disposable clean Debian source build.

 -- SupraLINUX QA <qa@supralinux.invalid>  Thu, 15 Oct 2026 00:00:00 +0000
EOF
cat > "$WORK/source/debian/control" <<'EOF'
Source: supralinux-hosted-sbuild-smoke
Section: misc
Priority: optional
Maintainer: SupraLINUX QA <qa@supralinux.invalid>
Build-Depends: debhelper-compat (= 13)
Standards-Version: 4.7.0
Rules-Requires-Root: no

Package: supralinux-hosted-sbuild-smoke
Architecture: any
Depends: ${misc:Depends}
Description: Disposable hosted build mechanism validation package
 This never becomes a published SupraLINUX product package.
EOF
cat > "$WORK/source/debian/rules" <<'EOF'
#!/usr/bin/make -f
%:
	dh $@
EOF
chmod 0755 "$WORK/source/debian/rules"
printf '3.0 (native)\n' > "$WORK/source/debian/source/format"
printf 'isolated hosted sbuild mechanism\n' > "$WORK/source/sample.txt"
printf 'sample.txt usr/share/supralinux-qa/\n' > "$WORK/source/debian/install"
[[ "$(dpkg-parsechangelog -l "$WORK/source/debian/changelog" -S Version)" == 0.1 ]]
(cd "$WORK" && dpkg-source -b source)
DSC="$WORK/supralinux-hosted-sbuild-smoke_0.1.dsc"
[[ -f "$DSC" ]]
# Independent buildd tarball, no injected KDE SDK packages.
timeout --signal=TERM --kill-after=30s 600 \
  env -u TMPDIR mmdebstrap --mode=root --variant=buildd \
    --architectures=amd64 --components=main,universe --format=tar \
    resolute "$WORK/resolute-amd64.tar" \
    "deb http://archive.ubuntu.com/ubuntu resolute main universe" \
    "deb http://archive.ubuntu.com/ubuntu resolute-updates main universe" \
    "deb http://security.ubuntu.com/ubuntu resolute-security main universe"
[[ -s "$WORK/resolute-amd64.tar" ]]
# No selection of another, preinstalled sbuild chroot.
timeout --signal=TERM --kill-after=30s 600 \
  sbuild --chroot-mode=unshare --chroot="$WORK/resolute-amd64.tar" \
    --dist=resolute --arch=amd64 --no-run-lintian \
    --build-dir="$WORK/out" "$DSC"
DEB="$(find "$WORK/out" -maxdepth 1 -name '*.deb' -type f -print -quit)"
CHANGES="$(find "$WORK/out" -maxdepth 1 -name '*.changes' -type f -print -quit)"
BUILDINFO="$(find "$WORK/out" -maxdepth 1 -name '*.buildinfo' -type f -print -quit)"
[[ -n "$DEB" && -n "$CHANGES" && -n "$BUILDINFO" ]]
[[ "$(find "$WORK/out" -maxdepth 1 -name '*.deb' -type f | wc -l)" == 1 ]]
[[ "$(find "$WORK/out" -maxdepth 1 -name '*.changes' -type f | wc -l)" == 1 ]]
[[ "$(find "$WORK/out" -maxdepth 1 -name '*.buildinfo' -type f | wc -l)" == 1 ]]
[[ "$(dpkg-deb -f "$DEB" Package)" == supralinux-hosted-sbuild-smoke ]]
[[ "$(dpkg-deb -f "$DEB" Version)" == 0.1 ]]
[[ "$(dpkg-deb -f "$DEB" Architecture)" == amd64 ]]
grep -Fxq 'Build-Architecture: amd64' "$BUILDINFO"
printf '%s\n' SUPRALINUX_HOSTED_SBUILD_UNSHARE_SMOKE_PASS
sha256sum "$DEB" "$CHANGES" "$BUILDINFO"
