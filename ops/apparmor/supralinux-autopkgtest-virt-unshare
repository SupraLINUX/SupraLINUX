# SupraLINUX authoritative runner profile for autopkgtest-virt-unshare.
# Ubuntu keeps kernel.apparmor_restrict_unprivileged_userns=1 globally.
# This reviewed executable gets the narrow userns exception recommended by
# Ubuntu; child processes inherit this named unconfined profile unless a
# more-specific profile applies.

abi <abi/5.0>,
include <tunables/global>

profile supralinux-autopkgtest-virt-unshare /usr/bin/autopkgtest-virt-unshare flags=(unconfined) {
  userns,

  include if exists <local/supralinux-autopkgtest-virt-unshare>
}
