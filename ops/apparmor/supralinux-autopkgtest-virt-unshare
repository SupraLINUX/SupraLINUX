# SupraLINUX authoritative runner profile for autopkgtest-virt-unshare.
# Keep Ubuntu's global unprivileged-userns restriction enabled; grant userns
# only to this reviewed testbed launcher and make /usr/bin/unshare inherit it.

abi <abi/5.0>,
include <tunables/global>

profile supralinux-autopkgtest-virt-unshare flags=(attach_disconnected mediate_deleted) {
  allow all,
  /usr/bin/autopkgtest-virt-unshare rix,
  /usr/bin/unshare ix,

  userns,
  mount,
  umount,
  pivot_root,

  include if exists <local/supralinux-autopkgtest-virt-unshare>
}
