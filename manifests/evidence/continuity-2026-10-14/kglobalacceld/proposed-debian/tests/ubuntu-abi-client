#!/usr/bin/env bash
set -Eeuo pipefail
BASE=/var/tmp/supralinux-kglobalacceld-baseline
dpkg --compare-versions "$(cat "${BASE}/ubuntu-version")" lt 6.7.5-0supralinux2
sha256sum --check "${BASE}/ubuntu-clients.sha256"
sha256sum --check "${BASE}/ubuntu-runtime-consumers.sha256"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' kwin-wayland kwin-x11 libkwin6 libkwin-x11-6 > "${BASE}/candidate-runtime-consumer-versions"
cmp "${BASE}/ubuntu-runtime-consumer-versions" "${BASE}/candidate-runtime-consumer-versions"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 libqt6gui6 libqt6widgets6 libqt6dbus6 > "${BASE}/candidate-provider-versions"
cmp "${BASE}/ubuntu-provider-versions" "${BASE}/candidate-provider-versions"
python3 "${BASE}/source/run-private.py" application "${BASE}/build/shortcut-client" "${BASE}/upgraded-application"
# The unchanged original public application remains mandatory after actual APT upgrade.
# The private SDK boundary is explicit: retain the old binary as a strict negative,
# then run the identical private source rebuilt by the separate consumer test.
python3 "${BASE}/source/run-private.py" library-negative "${BASE}/build/direct-sdk-client" "${BASE}/upgraded-private-negative" _ZN13KGlobalAccelD22setForeignShortcutKeysERK5QListI7QStringERKS0_I12QKeySequenceE
for package in kglobalacceld libkglobalacceld-dev libkglobalacceld0; do
    test "$(dpkg-query -W -f='${Version}' "${package}")" = 6.7.5-0supralinux2
done
readelf -d /usr/lib/x86_64-linux-gnu/libKGlobalAccelD.so.0 | grep -F 'Library soname: [libKGlobalAccelD.so.0]'
test -s /usr/lib/x86_64-linux-gnu/qt6/plugins/org.kde.kglobalacceld.platforms/KGlobalAccelDXcb.so
test -s /usr/lib/systemd/user/plasma-kglobalaccel.service
test -s /etc/xdg/autostart/kglobalacceld.desktop
test -s /usr/lib/x86_64-linux-gnu/cmake/KGlobalAccelD/KGlobalAccelDConfigVersion.cmake
apt-get check
