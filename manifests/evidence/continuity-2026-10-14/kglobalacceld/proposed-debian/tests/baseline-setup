#!/usr/bin/env bash
set -Eeuo pipefail
apt-get install -y --no-install-recommends build-essential cmake libkf6globalaccel-dev libkglobalacceld-dev libkf6windowsystem-dev libkf6coreaddons-dev libkf6config-dev libkf6service-dev libkf6kio-dev libkf6jobwidgets-dev kglobalacceld kwin-wayland=4:6.6.6-0ubuntu0.1 kwin-x11=4:6.6.4-0ubuntu1 libkwin6=4:6.6.6-0ubuntu0.1 libkwin-x11-6=4:6.6.4-0ubuntu1 qt6-base-dev qt6-base-private-dev=6.10.2+dfsg-7 qt6-qpa-plugins libx11-dev libxtst-dev xvfb dbus libglib2.0-bin python3
BASE=/var/tmp/supralinux-kglobalacceld-baseline
mkdir -p "${BASE}/source"
cp -a "$(dirname "$0")/client/." "${BASE}/source/"
cmake -S "${BASE}/source" -B "${BASE}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${BASE}/build" --parallel 2
python3 "${BASE}/source/run-private.py" application "${BASE}/build/shortcut-client" "${BASE}/ubuntu-application"
python3 "${BASE}/source/run-private.py" library "${BASE}/build/direct-sdk-client" "${BASE}/ubuntu-library"
dpkg-query -W -f='${Version}' kglobalacceld > "${BASE}/ubuntu-version"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 libqt6gui6 libqt6widgets6 libqt6dbus6 > "${BASE}/ubuntu-provider-versions"
sha256sum "${BASE}/build/shortcut-client" "${BASE}/build/direct-sdk-client" > "${BASE}/ubuntu-clients.sha256"

# Record every authenticated declared original runtime consumer before upgrade.
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' kwin-wayland kwin-x11 libkwin6 libkwin-x11-6 > "${BASE}/ubuntu-runtime-consumer-versions"
sha256sum /usr/bin/kwin_wayland /usr/bin/kwin_x11 /usr/lib/x86_64-linux-gnu/libkwin.so.6 /usr/lib/x86_64-linux-gnu/libkwin-x11.so.6 > "${BASE}/ubuntu-runtime-consumers.sha256"
cmp "${BASE}/source/ubuntu-runtime-consumer-versions" "${BASE}/ubuntu-runtime-consumer-versions"
sha256sum --check "${BASE}/source/ubuntu-runtime-consumers.sha256"
apt-get check
