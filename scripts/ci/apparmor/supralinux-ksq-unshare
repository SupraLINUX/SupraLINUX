# SupraLINUX KSQ GitHub-hosted build-container AppArmor profile.
#
# Origin:
#   Derived from the current Moby/Docker docker-default AppArmor template.
#   https://github.com/moby/profiles/blob/main/apparmor/template.go
#
# SupraLINUX delta:
#   docker-default contains an unconditional `deny mount,` rule. KSQ-1 needs
#   nested user+mount namespaces for mmdebstrap --mode=unshare and
#   sbuild --chroot-mode=unshare. The rules below are restricted to operations
#   observed in the pinned Resolute toolchain, its dedicated temporary roots
#   under /tmp/mmdebstrap.*/ and /tmp/tmp.sbuild.*/, and the one certified
#   Ubuntu snapshot mirror used by KSQ.
#
# Proven requirements:
#   - util-linux unshare recursively makes / private;
#   - mmdebstrap 1.5.7 mounts canonical devices, devpts, /sys and /proc below
#     /tmp/mmdebstrap.*/ (canonical mmdebstrap PASS: run 33424405355 attempt 2);
#   - mmdebstrap's upstream file-mirror-automount hook uses
#     `mount -o ro,bind <file-mirror> <rootdir>/<file-mirror>` in unshare mode;
#   - util-linux mount implements bind+ro as a bind followed by an additional
#     read-only bind remount; this is userspace behavior, not one atomic kernel
#     mount operation;
#   - local-only gate run 33471101421 proved the certified mirror bind is
#     required; run 33471523056 then proved the initial bind succeeded after
#     adding it, but the subsequent read-only transition was denied, requiring
#     the narrowly-scoped remount rule below;
#   - the only certified mirror authorized here is
#       /opt/supralinux/archive/20260829T022000Z/ubuntu/;
#   - sbuild 0.91.2ubuntu3 uses /usr/libexec/sbuild-usernsexec; the exact helper
#     was captured with SHA-256
#     218821c4a8892c60847be58c80e4d1fb02702b17ac6f7dce412faadecd8afc0a;
#   - sbuild smoke run 33431673769 proved its unpack-root self-rbind at
#     /tmp/tmp.sbuild.*/ is required;
#   - focused local-only probe run 33498287161, artifact 9796670616, captured
#     the exact AppArmor denial for UNSHARE_BIND_MOUNTS:
#       source=/opt/supralinux/archive/20260829T022000Z/ubuntu/
#       target=/tmp/tmp.sbuild.*/opt/supralinux/archive/20260829T022000Z/ubuntu/
#       flags="rw, rbind";
#   - the same run shows sbuild-usernsexec invokes its current session helper
#     with --pivotroot; no additional pivot_root permission is granted here
#     unless a concrete denial proves it necessary;
#   - that helper also mounts only the canonical /dev devices, devpts, tmpfs
#     /dev/shm, rbind /sys, tmpfs /sys/kernel and proc for the session path
#     already observed and scoped below.
#
# Security scope:
#   This profile is for the dedicated SupraLINUX KSQ GitHub Actions job
#   container. It does not grant CAP_SYS_ADMIN to the parent Docker container,
#   does not use privileged mode, and does not disable Ubuntu's unprivileged
#   userns policy. Mount targets are restricted to tool-owned temporary roots,
#   except for the single propagation change on / required by util-linux
#   unshare. The only external repository source is the exact certified
#   snapshot path. For mmdebstrap it is explicitly transitioned read-only;
#   sbuild receives only the exact rw,rbind syscall its helper emitted, while
#   the source itself is supplied to the container by Docker as a read-only
#   bind mount.
#
# Removal condition:
#   Remove this override when Docker's default profile permits the exact
#   unprivileged mount-namespace operations required by the certified KSQ build
#   path, or when the KSQ build architecture no longer requires nested unshare.

abi <abi/3.0>,
#include <tunables/global>

profile supralinux-ksq-unshare flags=(attach_disconnected,mediate_deleted) {
  # Match the compatibility envelope of Docker's generated default profile.
  #include <abstractions/base>

  network,
  deny network alg,
  deny network vsock,

  capability,
  file,
  umount,

  # Host / runtime processes may signal the container.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,

  # Processes in this profile may signal one another.
  signal (send,receive) peer=supralinux-ksq-unshare,

  # Keep Docker's protected /proc policy.
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # SupraLINUX KSQ delta from docker-default.
  # 1. util-linux unshare --mount defaults to recursively making / private.
  mount options=(rw,make-rprivate) -> /,

  # 2. mmdebstrap 1.5.7 setup_mounts: canonical device bind mounts used when
  #    mknod is unavailable in unshare mode. /dev/console is included in the
  #    canonical set even though Docker's job container currently lacks it.
  mount options=(rw,bind) /dev/console -> /tmp/mmdebstrap.*/dev/console,
  mount options=(rw,bind) /dev/full -> /tmp/mmdebstrap.*/dev/full,
  mount options=(rw,bind) /dev/null -> /tmp/mmdebstrap.*/dev/null,
  mount options=(rw,bind) /dev/random -> /tmp/mmdebstrap.*/dev/random,
  mount options=(rw,bind) /dev/tty -> /tmp/mmdebstrap.*/dev/tty,
  mount options=(rw,bind) /dev/urandom -> /tmp/mmdebstrap.*/dev/urandom,
  mount options=(rw,bind) /dev/zero -> /tmp/mmdebstrap.*/dev/zero,
  mount options=(rw,bind) /dev/shm/ -> /tmp/mmdebstrap.*/dev/shm/,

  # 3. mmdebstrap private devpts, /sys and /proc setup.
  mount fstype=devpts -> /tmp/mmdebstrap.*/dev/pts/,
  mount options=(rw,rbind) /sys/ -> /tmp/mmdebstrap.*/sys/,
  mount fstype=proc -> /tmp/mmdebstrap.*/proc/,
  mount options=(rw,rbind) /proc/ -> /tmp/mmdebstrap.*/proc/,
  mount options=(rw,make-rslave) -> /tmp/mmdebstrap.*/proc/,

  # 4. mmdebstrap file-mirror-automount for the one certified local snapshot.
  #    `mount -o ro,bind` is implemented by util-linux as an initial bind plus
  #    a second remount that makes only the destination VFS mount read-only.
  #    Do not allow rw, rbind, another source, or another destination here.
  mount options=(ro,bind) /opt/supralinux/archive/20260829T022000Z/ubuntu/ -> /tmp/mmdebstrap.*/opt/supralinux/archive/20260829T022000Z/ubuntu/,
  remount options=(ro,bind) /tmp/mmdebstrap.*/opt/supralinux/archive/20260829T022000Z/ubuntu/,

  # 5. sbuild 0.91.2ubuntu3 /usr/libexec/sbuild-usernsexec session setup.
  #    First make the unpack root a mountpoint, then allow exactly the external
  #    snapshot rbind proven by run 33498287161. No arbitrary source or target
  #    under the sbuild root is authorized.
  mount options=(rw,rbind) /tmp/tmp.sbuild.*/ -> /tmp/tmp.sbuild.*/,
  mount options=(rw,rbind) /opt/supralinux/archive/20260829T022000Z/ubuntu/ -> /tmp/tmp.sbuild.*/opt/supralinux/archive/20260829T022000Z/ubuntu/,

  mount options=(rw,bind) /dev/console -> /tmp/tmp.sbuild.*/dev/console,
  mount options=(rw,bind) /dev/full -> /tmp/tmp.sbuild.*/dev/full,
  mount options=(rw,bind) /dev/null -> /tmp/tmp.sbuild.*/dev/null,
  mount options=(rw,bind) /dev/random -> /tmp/tmp.sbuild.*/dev/random,
  mount options=(rw,bind) /dev/tty -> /tmp/tmp.sbuild.*/dev/tty,
  mount options=(rw,bind) /dev/urandom -> /tmp/tmp.sbuild.*/dev/urandom,
  mount options=(rw,bind) /dev/zero -> /tmp/tmp.sbuild.*/dev/zero,

  mount fstype=devpts -> /tmp/tmp.sbuild.*/dev/pts/,
  mount fstype=tmpfs -> /tmp/tmp.sbuild.*/dev/shm/,
  mount options=(rw,rbind) /sys/ -> /tmp/tmp.sbuild.*/sys/,
  mount fstype=tmpfs -> /tmp/tmp.sbuild.*/sys/kernel/,
  mount fstype=proc -> /tmp/tmp.sbuild.*/proc/,

  # Keep Docker's protected /sys policy.
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Same-container tracing only, subject to the remaining kernel controls.
  ptrace (trace,tracedby,read,readby) peer=supralinux-ksq-unshare,
}
