#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all reproducible=-fixfilepath
export DEB_PYTHON_INSTALL_LAYOUT = deb

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=ON -DBUILD_TESTING=ON -DBUILD_DESIGNERPLUGIN=ON

override_dh_auto_test:
	LANG=C.UTF-8 LC_ALL=C.UTF-8 xvfb-run -a sh -ec 'openbox >/tmp/kwidgetsaddons-openbox.log 2>&1 & wm_pid=$$!; trap "kill $$wm_pid 2>/dev/null || true" EXIT; ready=0; for i in $$(seq 1 50); do if xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -Eq "_NET_SUPPORTING_WM_CHECK\\(WINDOW\\): window id # 0x[0-9a-fA-F]+"; then ready=1; break; fi; sleep 0.1; done; test "$$ready" -eq 1; dh_auto_test --no-parallel'
