#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all reproducible=-fixfilepath

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_QCH=OFF -DBUILD_TESTING=ON -DSONNET_USE_WIDGETS=ON -DSONNET_USE_QML=ON -DSONNET_NO_BACKENDS=OFF -DBUILD_DESIGNERPLUGIN=ON

override_dh_auto_test:
	LANG=C.UTF-8 LC_ALL=C.UTF-8 xvfb-run -a dh_auto_test --no-parallel
