#!/usr/bin/env python3
"""Verify the unchanged Ubuntu SDK client and complete candidate ownership."""
import os
import shutil
import subprocess
from pathlib import Path
base = Path('/var/tmp/supralinux-kconfig-baseline')
candidate = '6.30.0-0supralinux5'
packages = ['libkf6config-bin', 'libkf6config-data', 'libkf6config-dev', 'libkf6config-dev-bin',
            'libkf6config-doc', 'libkf6configcore6', 'libkf6configgui6', 'libkf6configqml6', 'qml6-module-org-kde-config']
for package in packages:
    assert subprocess.check_output(['dpkg-query','-W','-f=${Version}',package],text=True).strip() == candidate
assert subprocess.check_output(['dpkg-query','-W','-f=${Version}','libqt6core6t64'],text=True).strip() == (base/'ubuntu-qt-core-version').read_text().strip()
subprocess.run(['sha256sum','--check','--strict',str(base/'binary-sha256.txt')],check=True)
multiarch = subprocess.check_output(['dpkg-architecture','-qDEB_HOST_MULTIARCH'],text=True).strip()
tool = f'/usr/lib/{multiarch}/libexec/kf6/kconf_update'
owner = subprocess.check_output(['dpkg-query','-S',tool],text=True).strip().split(': ',1)[0]
assert owner.split(':')[0] == 'libkf6config-bin', owner
for package, soname in [('libkf6configcore6','libKF6ConfigCore.so.6'), ('libkf6configgui6','libKF6ConfigGui.so.6'), ('libkf6configqml6','libKF6ConfigQml.so.6')]:
    path = Path(f'/usr/lib/{multiarch}/{soname}')
    assert f'Library soname: [{soname}]' in subprocess.check_output(['readelf','-d',str(path)],text=True)
    assert 'not found' not in subprocess.check_output(['ldd',str(path)],text=True)
subprocess.run([str(base/'run-session'),str(base/'build/ubuntu-kconfig-client')],check=True)
subprocess.run(['apt-get','check'],check=True)
shutil.copytree(base,Path(os.environ['AUTOPKGTEST_ARTIFACTS'])/'ubuntu-compiled-client',dirs_exist_ok=True)
print('Unchanged Ubuntu client, three SONAMEs, Qt version and Ubuntu-compatible kconf_update ownership: PASS')
