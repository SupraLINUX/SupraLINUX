#!/usr/bin/env bash
set -Eeuo pipefail
apt-get install -y --no-install-recommends build-essential cmake libksysguard-dev libsensors-dev qt6-base-dev qt6-declarative-dev qt6-qpa-plugins fonts-dejavu-core dbus libglib2.0-bin python3
BASE=/var/tmp/supralinux-libksysguard-baseline
mkdir -p "${BASE}/source"
cp -a "$(dirname "$0")/client/." "${BASE}/source/"
cmake -S "${BASE}/source" -B "${BASE}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${BASE}/build" --parallel 2
python3 "${BASE}/source/run-private.py" "${BASE}/build/stats-server" "${BASE}/build/stats-client" "${BASE}/ubuntu-scene"
dpkg-query -W -f='${Version}' libksysguardsensors2 > "${BASE}/ubuntu-version"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 libqt6gui6 libqt6dbus6 libqt6qml6 libqt6quick6 libqt6quickcontrols2-6 libqt6quicktemplates2-6 libqt6widgets6 libqt6network6 > "${BASE}/ubuntu-provider-versions"
sha256sum "${BASE}/build/stats-server" "${BASE}/build/stats-client" > "${BASE}/ubuntu-client.sha256"
