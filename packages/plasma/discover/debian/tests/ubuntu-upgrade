#!/usr/bin/env bash
set -Eeuo pipefail
BASE=/var/tmp/supralinux-discover-baseline
source_dir="$(cd "$(dirname "$0")/.." && pwd)"
expected="$(dpkg-parsechangelog -l "${source_dir}/changelog" -S Version)"
packages=(
  plasma-discover
  kde-config-updates
  plasma-discover-backend-flatpak
  plasma-discover-backend-fwupd
  plasma-discover-backend-snap
  plasma-discover-common
  plasma-discover-notifier
)
test -s "${BASE}/ubuntu-versions.tsv"
for pkg in "${packages[@]}"; do
  installed="$(dpkg-query -W -f='${Version}' "${pkg}")"
  [[ "${installed}" == "${expected}" ]]
  original="$(awk -F '\t' -v p="${pkg}" '$1==p {print $2}' "${BASE}/ubuntu-versions.tsv")"
  [[ -n "${original}" ]]
  dpkg --compare-versions "${expected}" gt "${original}"
done
apt-get check
printf 'Real Ubuntu-to-SupraLINUX Discover seven-binary upgrade: PASS\n'
