#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS=hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON

# flatpaktest talks to public Flathub and installs/removes Flatpak content.
# CategoriesTest inspects installed libdiscover translations. Stage the
# unchanged upstream install tree in a disposable DESTDIR so ki18n_install(po)
# has materialized those catalogs before the normal pre-install test phase.
override_dh_auto_test:
	set -e; \
	test_root="$(CURDIR)/debian/test-root"; \
	rm -rf "$$test_root"; \
	trap 'rm -rf "$$test_root"' EXIT INT TERM; \
	builddir="obj-$$(dpkg-architecture -qDEB_HOST_GNU_TYPE)"; \
	test -d "$$builddir"; \
	DESTDIR="$$test_root" cmake --install "$$builddir" --prefix /usr; \
	XDG_DATA_DIRS="$$test_root/usr/share:/usr/local/share:/usr/share" \
	QT_QPA_PLATFORM=offscreen \
	dh_auto_test -- ARGS="--output-on-failure --verbose -R ^CategoriesTest$$"
