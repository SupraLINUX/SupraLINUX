#!/usr/bin/env bash
set -Eeuo pipefail
BASE=/var/tmp/supralinux-kactivitymanagerd-baseline
sha256sum --check --strict "${BASE}/ubuntu-client.sha256"
[[ $(dpkg-query -W -f='${Version}' libqt6core6t64) == $(cat "${BASE}/ubuntu-qt-core-version") ]]
[[ $(dpkg-query -W -f='${Version}' libplasmaactivities7) == $(cat "${BASE}/ubuntu-activities-version") ]]
python3 "${BASE}/source/run-session.py" "${BASE}/build/ubuntu-kactivitymanagerd-client" "${AUTOPKGTEST_ARTIFACTS}/unchanged-ubuntu-client"
dpkg --compare-versions "$(dpkg-query -W -f='${Version}' kactivitymanagerd)" gt "$(cat "${BASE}/ubuntu-version")"
apt-get check
cp -a "${BASE}" "${AUTOPKGTEST_ARTIFACTS}/ubuntu-client-baseline"
