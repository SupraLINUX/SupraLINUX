#!/usr/bin/env python3
import subprocess
from pathlib import Path
candidate = '4:6.7.5-0supralinux1'
baseline = Path('/var/tmp/supralinux-ubuntu-package-version').read_text().strip()
assert subprocess.check_output(['dpkg-query','-W','-f=${Version}','plasma-workspace-wallpapers'],text=True).strip() == candidate
subprocess.run(['dpkg','--compare-versions',candidate,'gt',baseline],check=True)
subprocess.run(['apt-get','check'],check=True)
subprocess.run([str(Path(__file__).with_name('wallpaper-resources'))],check=True)
print(f'Ubuntu {baseline} -> SupraLINUX {candidate}: PASS')
