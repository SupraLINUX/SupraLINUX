#!/usr/bin/env bash
set -Eeuo pipefail
BASE=/var/tmp/supralinux-kde-cli-tools-baseline
sha256sum --check --strict "${BASE}/ubuntu-client.sha256"
for package in kde-cli-tools kde-cli-tools-data; do
    [[ $(dpkg-query -W -f='${Version}' "${package}") == 4:6.7.5-0supralinux1 ]]
done
dpkg --compare-versions 4:6.7.5-0supralinux1 gt "$(cat "${BASE}/ubuntu-version")"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 libqt6gui6 libqt6dbus6 libqt6widgets6 libqt6svg6 > "${AUTOPKGTEST_TMP}/providers"
cmp "${BASE}/ubuntu-provider-versions" "${AUTOPKGTEST_TMP}/providers"
python3 "${BASE}/source/run-private.py" "${BASE}/build/cli-client" "${AUTOPKGTEST_ARTIFACTS}/unchanged-ubuntu-client"
apt-get check
cp -a "${BASE}" "${AUTOPKGTEST_ARTIFACTS}/ubuntu-client-baseline"
