#!/usr/bin/make -f
# -*- makefile -*-

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -Skf6 -- -DBUILD_TESTING=ON -DBUILD_DOC=ON -DWITH_X11=ON "-DCMAKE_TEST_LAUNCHER=$(CURDIR)/debian/tests/upstream-session;--native"

override_dh_auto_test:
	debian/tests/upstream-session --suite dh_auto_test -- ARGS="--output-on-failure --verbose"
