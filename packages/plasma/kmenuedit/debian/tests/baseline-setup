#!/usr/bin/env bash
set -Eeuo pipefail
apt-get install -y --no-install-recommends build-essential cmake pkgconf kmenuedit qt6-base-dev qt6-qpa-plugins fonts-dejavu-core python3 dbus-daemon xvfb xauth libx11-6 libxtst6
BASE=/var/tmp/supralinux-kmenuedit-baseline
test ! -e "${BASE}"
mkdir -p "${BASE}/source"
cp -a "$(dirname "$0")/client/." "${BASE}/source/"
cmake -S "${BASE}/source" -B "${BASE}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${BASE}/build" --parallel 2
python3 "${BASE}/source/run-private.py" editor "${BASE}/original-ubuntu" --public-client "${BASE}/build/menu-client"
dpkg-query -W -f='${Version}' kmenuedit > "${BASE}/ubuntu-version"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 libqt6gui6 libqt6dbus6 libqt6widgets6 > "${BASE}/ubuntu-provider-versions"
sha256sum "${BASE}/build/menu-client" > "${BASE}/ubuntu-client.sha256"
