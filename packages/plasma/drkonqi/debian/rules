#!/usr/bin/make -f
# -*- makefile -*-

export DEB_BUILD_MAINT_OPTIONS=hardening=+all
export QT_QPA_PLATFORM=offscreen

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON -DWITH_GDB12=ON -DWITH_PYTHON_VENDORING=OFF

override_dh_auto_test:
	QT_QPA_PLATFORM=offscreen dh_auto_test --no-parallel
