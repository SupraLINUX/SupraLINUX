#!/usr/bin/env bash
set -Eeuo pipefail
BASE=/var/tmp/supralinux-thunderbolt-baseline
cmake -S "${BASE}/source" -B "${AUTOPKGTEST_TMP}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${AUTOPKGTEST_TMP}/build" --parallel 2
"${BASE}/run-session" "${AUTOPKGTEST_TMP}/build/ubuntu-thunderbolt-client" | tee "${AUTOPKGTEST_ARTIFACTS}/rebuilt-consumer-output.txt"
