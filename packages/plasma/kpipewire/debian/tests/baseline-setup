#!/usr/bin/env bash
set -Eeuo pipefail
apt-get install -y --no-install-recommends build-essential cmake pkgconf libkpipewire-dev libpipewire-0.3-dev qt6-declarative-dev python3 pipewire-bin ffmpeg qt6-qpa-plugins qml6-module-qtquick qml6-module-qtqml-models qml6-module-qtqml-workerscript
BASE=/var/tmp/supralinux-kpipewire-baseline
mkdir -p "${BASE}/source"
cp -a "$(dirname "$0")/client/." "${BASE}/source/"
cmake -S "${BASE}/source" -B "${BASE}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${BASE}/build" --parallel 2
python3 "${BASE}/source/run-private-video.py" "${BASE}/build/ubuntu-kpipewire-client" "${BASE}/ubuntu-results" "${BASE}/build/private-video-source"
dpkg-query -W -f='${Version}' libkpipewire6 > "${BASE}/ubuntu-version"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 libpipewire-0.3-0t64 libavcodec62 libavformat62 libavfilter11 libavutil60 libswscale9 > "${BASE}/ubuntu-provider-versions"
sha256sum "${BASE}/build/ubuntu-kpipewire-client" "${BASE}/build/private-video-source" > "${BASE}/ubuntu-client.sha256"
