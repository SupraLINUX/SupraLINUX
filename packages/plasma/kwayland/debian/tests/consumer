#!/usr/bin/env bash
set -Eeuo pipefail
BASE=/var/tmp/supralinux-kwayland-baseline
cmake -S "${BASE}/source" -B "${AUTOPKGTEST_TMP}/build" -DCMAKE_BUILD_TYPE=Release -DCANDIDATE_CONSUMER=ON
cmake --build "${AUTOPKGTEST_TMP}/build" --parallel 2
python3 "${BASE}/source/run-private.py" "${AUTOPKGTEST_TMP}/build/private-server" "${AUTOPKGTEST_TMP}/build/kwayland-client" "${AUTOPKGTEST_ARTIFACTS}/rebuilt-consumer"
