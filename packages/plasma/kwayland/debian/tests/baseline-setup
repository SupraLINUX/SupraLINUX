#!/usr/bin/env bash
set -Eeuo pipefail
apt-get install -y --no-install-recommends build-essential cmake pkgconf kwayland-dev kwayland6-data kwayland-doc libwayland-dev libwayland-bin plasma-wayland-protocols qt6-base-dev python3
BASE=/var/tmp/supralinux-kwayland-baseline
mkdir -p "${BASE}/source"
cp -a "$(dirname "$0")/client/." "${BASE}/source/"
cmake -S "${BASE}/source" -B "${BASE}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${BASE}/build" --parallel 2
python3 "${BASE}/source/run-private.py" "${BASE}/build/private-server" "${BASE}/build/kwayland-client" "${BASE}/ubuntu-results"
dpkg-query -W -f='${Version}' libkwaylandclient6 > "${BASE}/ubuntu-version"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 libqt6gui6 libwayland-client0 libwayland-server0 > "${BASE}/ubuntu-provider-versions"
sha256sum "${BASE}/build/kwayland-client" "${BASE}/build/private-server" > "${BASE}/ubuntu-client.sha256"
