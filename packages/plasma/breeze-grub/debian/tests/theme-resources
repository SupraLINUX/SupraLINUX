#!/usr/bin/env python3
"""Check installed upstream resources and the theme's image/font references."""
import hashlib
import datetime
import json
import re
import struct
import zlib
from pathlib import Path


def resource_hash(payload, name):
    if not name.endswith(".png"):
        return hashlib.sha256(payload).hexdigest()
    # dh_strip_nondeterminism rewrites tIME to SOURCE_DATE_EPOCH. Preserve
    # exact identity of every other chunk, including compressed pixel data.
    assert payload[:8] == b"\x89PNG\r\n\x1a\n", f"Invalid PNG: {name}"
    normalized = bytearray(payload[:8])
    offset = 8
    tags = []
    while offset < len(payload):
        assert offset + 12 <= len(payload), f"Truncated PNG: {name}"
        size, tag = struct.unpack(">I4s", payload[offset:offset + 8])
        end = offset + 12 + size
        assert end <= len(payload), f"Truncated PNG chunk: {name}"
        data = payload[offset + 8:end - 4]
        crc = struct.unpack(">I", payload[end - 4:end])[0]
        assert zlib.crc32(tag + data) & 0xffffffff == crc, f"Invalid PNG CRC: {name}"
        if tag == b"tIME":
            assert size == 7, f"Invalid PNG timestamp: {name}"
            datetime.datetime(*struct.unpack(">H5B", data))
        else:
            normalized.extend(payload[offset:end])
        tags.append(tag)
        offset = end
    assert tags[0] == b"IHDR" and tags[-1] == b"IEND" and tags.count(b"tIME") <= 1, name
    return hashlib.sha256(normalized).hexdigest()


def verify(theme, expected):
    actual = {str(p.relative_to(theme)) for p in theme.rglob("*") if p.is_file()}
    assert actual == set(expected), f"Installed resource set changed: {actual ^ set(expected)}"
    fonts = set()
    for name, digest in expected.items():
        payload = (theme / name).read_bytes()
        assert resource_hash(payload, name) == digest, f"Resource differs from signed upstream: {name}"
        if name.endswith(".png"):
            assert payload[:8] == b"\x89PNG\r\n\x1a\n" and payload[12:16] == b"IHDR", name
            assert all(struct.unpack(">II", payload[16:24])), f"Empty PNG: {name}"
        if name.endswith(".pf2"):
            assert payload[:12] == b"FILE\x00\x00\x00\x04PFF2", f"Invalid GRUB font: {name}"
            offset = 12
            while offset + 8 <= len(payload):
                tag, size = struct.unpack(">4sI", payload[offset:offset + 8])
                offset += 8
                if tag == b"DATA":
                    break
                assert offset + size <= len(payload), f"Truncated font: {name}"
                if tag == b"NAME":
                    fonts.add(payload[offset:offset + size].rstrip(b"\0").decode())
                offset += size
    text = "\n".join(line.split("#", 1)[0] for line in (theme / "theme.txt").read_text().splitlines())
    for pattern in re.findall(r'"([^"\n]+\.png)"', text):
        assert list(theme.glob(pattern)), f"Missing image pattern: {pattern}"
    for font in re.findall(r'(?:[\w-]*font)\s*[:=]\s*"([^"]+)"', text):
        assert font in fonts, f"Theme references missing GRUB font: {font}; available={fonts}"
    print(f"Verified {len(expected)} installed upstream resources, images and GRUB fonts")


if __name__ == "__main__":
    verify(Path("/usr/share/grub/themes/breeze"),
           json.loads(Path(__file__).with_name("theme-resources.json").read_text()))
