#!/usr/bin/env python3
"""Exercise the unchanged Ubuntu client/library and actual private candidate daemon."""
import os
import shutil
import subprocess
from pathlib import Path
base = Path('/var/tmp/supralinux-knighttime-baseline')
candidate = '6.7.5-0supralinux1'
baseline = (base/'ubuntu-dev-version').read_text().strip()
subprocess.run(['dpkg','--compare-versions',candidate,'gt',baseline],check=True)
for package in ['knighttime','knighttime-dev','libknighttime0']:
    assert subprocess.check_output(['dpkg-query','-W','-f=${Version}',package],text=True).strip() == candidate
assert subprocess.check_output(['dpkg-query','-W','-f=${Version}','libqt6core6t64'],text=True).strip() == (base/'ubuntu-qt-core-version').read_text().strip()
subprocess.run(['sha256sum','--check','--strict',str(base/'binary-sha256.txt')],check=True)
libraries = [Path(p) for p in subprocess.check_output(['dpkg','-L','libknighttime0'],text=True).splitlines() if p.endswith('/libKNightTime.so.0')]
assert len(libraries) == 1 and 'SONAME' in subprocess.check_output(['readelf','-d',str(libraries[0])],text=True)
assert 'libKNightTime.so.0' in subprocess.check_output(['readelf','-d',str(libraries[0])],text=True)
assert 'not found' not in subprocess.check_output(['ldd',str(libraries[0])],text=True)
subprocess.run([str(base/'run-session'),str(base/'build/ubuntu-knighttime-client')],check=True)
subprocess.run(['apt-get','check'],check=True)
shutil.copytree(base,Path(os.environ['AUTOPKGTEST_ARTIFACTS'])/'ubuntu-compiled-client',dirs_exist_ok=True)
print(f'Unchanged Ubuntu {baseline} client with complete SupraLINUX {candidate} library/daemon upgrade: PASS')
