#!/usr/bin/env bash
set -Eeuo pipefail
BASE=/var/tmp/supralinux-plasma-protocols-baseline
FIXTURE=$(cd "$(dirname "$0")" && pwd)
sha256sum --check --strict "${BASE}/unchanged-client.sha256"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 qt6-base-dev libwayland-client0 libwayland-server0 libwayland-dev libwayland-bin > "${AUTOPKGTEST_TMP}/providers"
cmp "${BASE}/ubuntu-providers" "${AUTOPKGTEST_TMP}/providers"
[[ $(dpkg-query -W -f='${Version}' plasma-wayland-protocols) == 1.22.0-0supralinux1 ]]
"${FIXTURE}/build-wire" /usr/share/plasma-wayland-protocols/plasma-window-management.xml "${AUTOPKGTEST_TMP}/candidate-wire"
python3 "${FIXTURE}/wire-probe.py" "${AUTOPKGTEST_TMP}/candidate-wire/server" "${BASE}/build/client" "${AUTOPKGTEST_ARTIFACTS}/unchanged-ubuntu-client"
sha256sum --check --strict "${BASE}/unchanged-client.sha256"
apt-get check
cp -a "${BASE}" "${AUTOPKGTEST_ARTIFACTS}/ubuntu-baseline"
