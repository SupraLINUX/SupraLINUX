#!/usr/bin/env bash
set -Eeuo pipefail
apt-get install -y --no-install-recommends build-essential cmake libkf6globalaccel-dev libkglobalacceld-dev libkf6windowsystem-dev libkf6coreaddons-dev libkf6config-dev libkf6service-dev libkf6kio-dev libkf6jobwidgets-dev kglobalacceld qt6-base-dev qt6-qpa-plugins libx11-dev libxtst-dev xvfb dbus libglib2.0-bin python3
BASE=/var/tmp/supralinux-kglobalacceld-baseline
mkdir -p "${BASE}/source"
cp -a "$(dirname "$0")/client/." "${BASE}/source/"
cmake -S "${BASE}/source" -B "${BASE}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${BASE}/build" --parallel 2
python3 "${BASE}/source/run-private.py" application "${BASE}/build/shortcut-client" "${BASE}/ubuntu-application"
python3 "${BASE}/source/run-private.py" library "${BASE}/build/direct-sdk-client" "${BASE}/ubuntu-library"
dpkg-query -W -f='${Version}' kglobalacceld > "${BASE}/ubuntu-version"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 libqt6gui6 libqt6widgets6 libqt6dbus6 > "${BASE}/ubuntu-provider-versions"
sha256sum "${BASE}/build/shortcut-client" "${BASE}/build/direct-sdk-client" > "${BASE}/ubuntu-clients.sha256"
