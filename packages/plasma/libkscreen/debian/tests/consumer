#!/usr/bin/env bash
set -Eeuo pipefail
BASE=/var/tmp/supralinux-libkscreen-baseline
cmake -S "${BASE}/source" -B "${AUTOPKGTEST_TMP}/build" -DCMAKE_BUILD_TYPE=Release -DCANDIDATE_CONSUMER=ON
cmake --build "${AUTOPKGTEST_TMP}/build" --parallel 2
python3 "${BASE}/source/run-private.py" "${AUTOPKGTEST_TMP}/build/screen-client" "${BASE}/source/profile.json" "${AUTOPKGTEST_ARTIFACTS}/rebuilt-fake"
python3 "${BASE}/source/run-private.py" "${AUTOPKGTEST_TMP}/build/screen-client" "${BASE}/source/profile.json" "${AUTOPKGTEST_ARTIFACTS}/rebuilt-xrandr" xrandr
