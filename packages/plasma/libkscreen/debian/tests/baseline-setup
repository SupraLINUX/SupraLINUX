#!/usr/bin/env bash
set -Eeuo pipefail
apt-get install -y --no-install-recommends build-essential cmake pkgconf libkscreen-dev libkscreen-bin libkscreen-data libkscreen-doc qt6-base-dev qt6-qpa-plugins python3 dbus-daemon libglib2.0-bin xvfb
BASE=/var/tmp/supralinux-libkscreen-baseline
mkdir -p "${BASE}/source"
cp -a "$(dirname "$0")/client/." "${BASE}/source/"
cmake -S "${BASE}/source" -B "${BASE}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${BASE}/build" --parallel 2
python3 "${BASE}/source/run-private.py" "${BASE}/build/screen-client" "${BASE}/source/profile.json" "${BASE}/ubuntu-fake"
python3 "${BASE}/source/run-private.py" "${BASE}/build/screen-client" "${BASE}/source/profile.json" "${BASE}/ubuntu-xrandr" xrandr
dpkg-query -W -f='${Version}' libkf6screen8 > "${BASE}/ubuntu-version"
dpkg-query -W -f='${Package} ${Architecture} ${Version}\n' libqt6core6t64 libqt6gui6 libqt6dbus6 libwayland-client0 libxcb-randr0 libxcb-dpms0 > "${BASE}/ubuntu-provider-versions"
sha256sum "${BASE}/build/screen-client" > "${BASE}/ubuntu-client.sha256"
