[Unit]
Description=SupraLinux disposable boot probe
DefaultDependencies=no
After=multi-user.target
ConditionPathExists=/usr/lib/systemd/systemd

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/supra-boot-probe
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=300
# Failure must be visible and must not leave the disposable guest at login.
ExecStopPost=/bin/sh -c 'if [ "$$SERVICE_RESULT" != success ]; then printf "SUPRA_BOOT_PROBE_FAILED result=%s status=%s\n" "$$SERVICE_RESULT" "$$EXIT_STATUS" > /dev/ttyS0; /usr/bin/systemctl --no-block poweroff; fi'
